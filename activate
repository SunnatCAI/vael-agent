#!/usr/bin/env bash
# ============================================================================
# venv-style activation for the VAEL dev environment (pm-managed tools).
#
#   source ./activate      (bash / zsh, repo root)
#   .\activate.ps1         (PowerShell)
#
# Emits the composed pm env (PATH + tool vars) into the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `vael` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `vael pm
# install` and `vael update` keep that check.
# ============================================================================
_VAEL_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_vael_test_env="--test-environment"
_vael_expect_extras=""
for _vael_arg in "$@"; do
    if [ -n "$_vael_expect_extras" ]; then
        _vael_test_env="--test-environment=$_vael_arg"
        _vael_expect_extras=""
        continue
    fi
    case "$_vael_arg" in
        --) break ;;
        --test-extras) _vael_expect_extras=1 ;;
        --test-extras=*) _vael_test_env="--test-environment=${_vael_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_vael_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _vael_arg _vael_test_env _vael_expect_extras
    return 2 2>/dev/null || exit 2
fi
# Setup runs in a child: failures must not exit or partially activate the
# caller's shell, and activation must not republish launchers or shell config.
if ! (
    unset PYTHONHOME PYTHONPATH VIRTUAL_ENV
    bash "$_VAEL_REPO/setup-vael.sh" --runtime-only "$_vael_test_env"
) >&2; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _vael_arg _vael_test_env _vael_expect_extras
    return 1 2>/dev/null || exit 1
fi
unset _vael_arg _vael_test_env _vael_expect_extras

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __VAEL_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

# Bootstrap Python only emits the environment; it does not install anything.
_vael_repo="$_VAEL_REPO"
_vael_py=""
for _vael_candidate in "$_vael_repo/.venv/bin/python" "$_vael_repo/.venv/Scripts/python.exe" \
                         "$_vael_repo/venv/bin/python" "$_vael_repo/venv/Scripts/python.exe"; do
    [ -x "$_vael_candidate" ] && { _vael_py="$_vael_candidate"; break; }
done
if [ -z "$_vael_py" ]; then
    for _vael_store in "${VAEL_RUNTIME_DIR:-}" "$_vael_repo/../tools" "${VAEL_HOME:-$HOME/.vael}/tools"; do
        [ -n "$_vael_store" ] || continue
        for _vael_candidate in "$_vael_store"/python-*/bin/python3 "$_vael_store"/python-*/python.exe "$_vael_store"/python-*/bin/python "$_vael_store"/python-*/bin/python.exe; do
            [ -x "$_vael_candidate" ] && { _vael_py="$_vael_candidate"; break; }
        done
        [ -n "$_vael_py" ] && break
    done
fi
if [ -z "$_vael_py" ]; then
    echo "activate: no bootstrap Python found; run setup-vael.sh" >&2
    return 1 2>/dev/null || exit 1
fi

# --- emit export lines from `pm env` ---
_vael_json="$(PYTHONHOME= PYTHONPATH="$_vael_repo" "$_vael_py" -m pm.environments)"
if [ -z "$_vael_json" ] || [ "${_vael_json#*{}" = "$_vael_json" ]; then
    echo "activate: could not read pm env (run ./setup-vael.sh first)" >&2
    unset _vael_repo _vael_os _vael_arch _vael_target _vael_store _vael_py _vael_json
    return 1 2>/dev/null || exit 1
fi

_vael_keys="$(printf '%s' "$_vael_json" | "$_vael_py" -c 'import json,sys; print(" ".join(json.load(sys.stdin)))' \
    | tr ' ' '\n' | grep -E '^[A-Za-z_][A-Za-z0-9_]*$' | tr '\n' ' ')"
[ -n "$_vael_keys" ] || _vael_keys="PATH"

# --- snapshot what we are about to change (deactivate restores this) ---
# __VAEL_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__VAEL_SAVED_PATH="$PATH"
for _vael_k in $_vael_keys; do
    eval "__VAEL_SAVED_$_vael_k=\"\${$_vael_k+set}\""
    eval "__VAEL_PRIOR_$_vael_k=\${$_vael_k-__VAEL_UNSET__}"
done

# Resolved before the export below replaces PATH.
_vael_cygpath="$(command -v cygpath 2>/dev/null || :)"

eval "$(printf '%s' "$_vael_json" | "$_vael_py" -c '
import json, sys, shlex, re
for k, v in json.load(sys.stdin).items():
    # Windows carries names like ProgramFiles(ARM) that are not valid
    # bash identifiers — skip them (they pass through untouched).
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k):
        continue
    print("export %s=%s" % (k, shlex.quote(str(v))))')"

# The MSYS/Cygwin runtime hands a native Windows Python these variables in
# Windows form (`C:\a;C:\b`) and converts them back only for its own children.
# Exported verbatim, bash splits PATH on ':' and finds no commands.
if [ -n "$_vael_cygpath" ]; then
    PATH="$("$_vael_cygpath" -u -p "$PATH")"
    for _vael_k in HOME TMPDIR TMP TEMP; do
        if [ -n "${!_vael_k-}" ]; then
            printf -v "$_vael_k" '%s' "$("$_vael_cygpath" -u "${!_vael_k}")"
        fi
    done
fi

# This checkout, not whichever `vael` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__VAEL_WORKTREE="$_vael_repo"
# The branch names the worktree. A checkout cannot share a branch with another.
__VAEL_WORKTREE_NAME="$(git -C "$_vael_repo" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__VAEL_WORKTREE_NAME" ] || [ "$__VAEL_WORKTREE_NAME" = HEAD ]; then
    __VAEL_WORKTREE_NAME="$(basename "$_vael_repo")"
fi
__VAEL_SAVED_PS1="${PS1-__VAEL_UNSET__}"
__VAEL_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__VAEL_UNSET__}"

_vael_worktree_here() {
    _vael_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_vael_top" && pwd -P)" = "$(cd "$__VAEL_WORKTREE" && pwd -P)" ]
}

vael() {
    _vael_worktree_here || {
        printf '%s\n' "vael: $(pwd) is outside $__VAEL_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__VAEL_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" vael "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe vael "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python vael "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe vael "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python vael "$@"
        else
            exec python vael "$@"
        fi
    )
}

_vael_prompt() {
    if [ "$__VAEL_SAVED_PS1" = "__VAEL_UNSET__" ]; then
        _vael_base_ps1=""
    else
        _vael_base_ps1="$__VAEL_SAVED_PS1"
    fi
    if _vael_worktree_here; then
        PS1="($__VAEL_WORKTREE_NAME) $_vael_base_ps1"
    else
        PS1="$_vael_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_vael_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_vael_prompt
fi
_vael_prompt

deactivate() {
    export PATH="$__VAEL_SAVED_PATH"
    for _vael_k in $__VAEL_KEY_LIST; do
        eval "_vael_was=\"\$__VAEL_SAVED_$_vael_k\""
        eval "_vael_old=\"\$__VAEL_PRIOR_$_vael_k\""
        if [ "$_vael_was" != "set" ]; then
            unset "$_vael_k"
        else
            export "$_vael_k=$_vael_old"
        fi
        unset "__VAEL_SAVED_$_vael_k" "__VAEL_PRIOR_$_vael_k"
    done
    if [ "$__VAEL_SAVED_PS1" = "__VAEL_UNSET__" ]; then
        unset PS1
    else
        PS1="$__VAEL_SAVED_PS1"
    fi
    if [ "$__VAEL_SAVED_PROMPT_COMMAND" = "__VAEL_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__VAEL_SAVED_PROMPT_COMMAND"
    fi
    unset __VAEL_SAVED_PATH __VAEL_KEY_LIST __VAEL_ACTIVATED \
          __VAEL_WORKTREE __VAEL_WORKTREE_NAME \
          __VAEL_SAVED_PS1 __VAEL_SAVED_PROMPT_COMMAND
    unset -f deactivate vael _vael_worktree_here _vael_prompt
    unset _vael_k _vael_was _vael_old _vael_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__VAEL_KEY_LIST="$_vael_keys"

unset _vael_repo _vael_os _vael_arch _vael_target _vael_store \
      _vael_py _vael_json _vael_keys _vael_k _vael_entry _vael_venvpy \
      _vael_winarch _vael_top _vael_cygpath
